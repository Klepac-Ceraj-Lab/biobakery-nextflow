// Default resource limits — override per process in profile configs
process {
    cpus   = { check_max(2   * task.attempt, 'cpus')   }
    memory = { check_max(4.GB * task.attempt, 'memory') }
    time   = { check_max(4.h  * task.attempt, 'time')   }

    errorStrategy = { task.exitStatus in [125,143,137,104,134,139] ? 'retry' : 'finish' }  // 125: slurm OUT_OF_MEMORY
    maxRetries    = 2
    maxErrors     = '-1'

    withName: 'single_end_kneaddata|paired_end_kneaddata' {
        cpus   = { check_max(8   * task.attempt, 'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(8.h   * task.attempt, 'time')   }
    }

    withName: metaphlan {
        cpus   = { check_max(8   * task.attempt, 'cpus')   }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(4.h   * task.attempt, 'time')   }
    }

    withName: metaphlan_bzip {
        cpus   = 1
        memory = { check_max(4.GB  * task.attempt, 'memory') }
        time   = { check_max(1.h   * task.attempt, 'time')   }
    }

    withName: metaphlan_merge {
        cpus   = 1
        memory = { check_max(8.GB  * task.attempt, 'memory') }
        time   = { check_max(1.h   * task.attempt, 'time')   }
    }

    withName: humann {
        cpus   = { check_max(16  * task.attempt, 'cpus')   }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time')   }
    }

    withName: 'humann_regroup|humann_regroup_ecs|humann_rename|humann_renorm|humann_join|humann_join_relab|humann_count_features|humann_feature_counts_merge|rna_dna_norm' {
        cpus   = 2
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(2.h   * task.attempt, 'time')   }
    }

    withName: baqlava {
        cpus   = { check_max(4   * task.attempt, 'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(8.h   * task.attempt, 'time')   }
    }

    withName: 'sample2markers|strainphlan' {
        cpus   = { check_max(8   * task.attempt, 'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(8.h   * task.attempt, 'time')   }
    }

    // ── SGB pipeline processes ──────────────────────────────────────────────
    withName: megahit {
        cpus   = { check_max(16  * task.attempt, 'cpus')   }
        memory = { check_max(64.GB * task.attempt, 'memory') }
        time   = { check_max(24.h  * task.attempt, 'time')   }
    }

    withName: align_and_depth {
        cpus   = { check_max(8   * task.attempt, 'cpus')   }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time')   }
    }

    withName: metabat2 {
        cpus   = { check_max(8   * task.attempt, 'cpus')   }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(8.h   * task.attempt, 'time')   }
    }

    withName: 'checkm2|checkm2_merge|mag_n50|checkm2_wrangling' {
        cpus   = { check_max(8   * task.attempt, 'cpus')   }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(8.h   * task.attempt, 'time')   }
    }

    withName: 'phylophlan_metagenomic|phylophlan_merge' {
        cpus   = { check_max(16  * task.attempt, 'cpus')   }
        memory = { check_max(64.GB * task.attempt, 'memory') }
        time   = { check_max(24.h  * task.attempt, 'time')   }
    }

    withName: 'mash_sketch|mash_paste|mash_dist|mash_list_inputs|sgb_cluster|merge_tax_abundance' {
        cpus   = { check_max(4   * task.attempt, 'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(4.h   * task.attempt, 'time')   }
    }

    // Small table and folder assembly steps: a script over a few text files.
    withName: 'kneaddata_read_counts|metaphlan_species_counts|humann_log_counts|stage_report_input|merge_report_input' {
        cpus   = 1
        memory = { check_max(8.GB * task.attempt, 'memory') }
        time   = { check_max(1.h  * task.attempt, 'time')   }
    }

    // A chained report is an extra on top of a profiling run, so its failure is
    // not the run's failure: the profiles and tables are already written and
    // published. vis and stats legitimately fail on a study too small or too
    // sparse to visualise -- an ordination of two samples, a heatmap of a
    // handful of features -- and losing a complete run at its last step over
    // that is the wrong trade. The failure is still reported in the log.
    //
    // Standalone `--workflow vis|stats` runs carry no REPORTING prefix and are
    // unaffected: there the report *is* the run, and a failure should fail.
    withName: '.*:REPORTING:.*' {
        errorStrategy = 'ignore'
    }

    // Concatenating a read pair when QC is bypassed: one cat, no tools.
    withName: merge_pairs {
        cpus   = 1
        memory = { check_max(4.GB * task.attempt, 'memory') }
        time   = { check_max(1.h  * task.attempt, 'time')   }
    }

    // ── vis / stats report processes ────────────────────────────────────────
    withName: 'identify_inputs|feature_table|trim_taxonomy|add_ec_names|covariate_equation|stratified_metadata|halla_transpose_metadata|archive_output' {
        cpus   = 1
        memory = { check_max(8.GB * task.attempt, 'memory') }
        time   = { check_max(1.h  * task.attempt, 'time')   }
    }

    withName: 'alpha_diversity|mantel_test|maaslin2|beta_diversity|permanova|stratified_barplot' {
        cpus   = 2
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(2.h   * task.attempt, 'time')   }
    }

    withName: halla {
        cpus   = { check_max(4    * task.attempt, 'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(4.h   * task.attempt, 'time')   }
    }

    // pweave renders every figure in one process, so the report is the one
    // heavy step of either workflow.
    withName: 'vis_report|stats_report' {
        cpus   = 4
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(6.h   * task.attempt, 'time')   }
    }

    withName: version_log {
        cpus   = 1
        memory = '1.GB'
        time   = '10.m'
    }
}

// Cap resources at user-defined maxima
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj as int, params.max_cpus as int) }
        catch (all) { return obj }
    }
}
